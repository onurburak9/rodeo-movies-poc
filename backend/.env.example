# Server Configuration
PORT=3001

# Database (PostgreSQL) - Optional
# Format: postgresql://username:password@host:port/database
# If not set, the app will work without database persistence
DATABASE_URL=postgresql://localhost:5432/rodeo_movies

# =============================================================================
# AI PROVIDERS (Hybrid Strategy)
# =============================================================================
# The app uses a hybrid AI strategy for optimal cost/accuracy:
# 1. OpenAI GPT-4o-mini is tried FIRST (cheapest, ~$0.0006/image)
# 2. Google Gemini is used as FALLBACK for low-confidence results (~$0.001875/image)
#
# REQUIRED: At least one AI provider must be configured
# RECOMMENDED: Set both for best results across all screenshot types
# =============================================================================

# OpenAI - Primary provider (REQUIRED or use Gemini)
# Get your API key: https://platform.openai.com/api-keys
# Pricing: GPT-4o-mini ~$0.0006 per image
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini - Fallback provider (OPTIONAL but RECOMMENDED)
# Get your API key: https://aistudio.google.com/app/apikey
# Pricing: Gemini Pro Vision ~$0.001875 per image
# Benefits: Better at Instagram posts, webpage screenshots, cluttered layouts
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# MOVIE DATABASE
# =============================================================================

# TMDB (The Movie Database) - REQUIRED
# Get your API key: https://www.themoviedb.org/settings/api
# Note: Free tier allows 40 requests per 10 seconds
TMDB_API_KEY=your_tmdb_api_key_here
